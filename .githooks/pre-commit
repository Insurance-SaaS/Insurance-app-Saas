#!/bin/sh
# Blocks commits that contain secrets. Enable once per clone with:
#   git config core.hooksPath .githooks
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, skipping secret scan (https://github.com/gitleaks/gitleaks)" >&2
  exit 0
fi
exec gitleaks protect --staged --redact --no-banner
