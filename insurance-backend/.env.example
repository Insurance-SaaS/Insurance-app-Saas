# ─── Application ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Number of reverse proxies in front of the app (1 on Fly.io), or true/false.
# Needed so rate limiting sees the client address instead of the proxy's.
TRUST_PROXY=false
# Comma-separated browser origins allowed by CORS. Empty = none in production.
CORS_ORIGINS=
# Maximum size of JSON bodies in bytes (file uploads have their own limits)
BODY_LIMIT_BYTES=1048576

# ─── Database (platform / control-plane database) ────────────────────
# Engine: postgres, mysql, mariadb, oracle or mssql. Tenants choose their own
# engine when they are onboarded; this is only the platform's own database.
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_user
DB_PASSWORD=your_password
# Database name (Oracle: the service name)
DB_NAME=insurance_platform
DB_POOL_SIZE=10
# DB_SSL=true
# MSSQL_TRUST_CERT=true

# Set up or upgrade the platform schema at startup. Convenient for development;
# in production run "npm run migrate:prod -- platform" and "-- tenants" as
# deployment steps instead and leave this off.
DB_AUTO_MIGRATE=true

# Connections per tenant database, and how long an unused tenant pool stays open
TENANT_DB_POOL_SIZE=5
TENANT_DS_IDLE_MS=600000

# Time zone used for "today" when a tenant has none in its config (config.timezone)
DEFAULT_TIMEZONE=Africa/Algiers

# ─── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# ─── JWT ──────────────────────────────────────────────────────────────
# Three different values, at least 32 characters each in production. The app
# refuses to start otherwise. Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_SECRET_KEY_REFRESH=your-jwt-refresh-secret-key-min-32-chars
# Signs platform-admin tokens.
JWT_PLATFORM_SECRET=your-platform-admin-jwt-secret

# ─── MinIO (Object Storage) ──────────────────────────────────────────
# Required in production: claim documents and photos are stored here.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key
MINIO_USE_SSL=false
# Address clients can reach the storage at, when it differs from the endpoint above
# MINIO_PUBLIC_URL=https://files.yourdomain.com
# Largest accepted upload (photos, PDF documents), in megabytes
# UPLOAD_MAX_FILE_MB=15
# Bucket names, if the defaults (claims, profile-pictures, quotes, contracts, documents, temp) do not suit
# MINIO_BUCKET_CLAIMS=claims
# MINIO_BUCKET_PROFILE_PICTURES=profile-pictures

# ─── Email (SMTP) ────────────────────────────────────────────────────
# Required in production: sign-up and password reset send their codes by email.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
# true for port 465 (implicit TLS)
EMAIL_SECURE=false
# Also used as the sender address
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_SENDER_NAME=Insurance

# ─── SMS (Infobip, optional) ─────────────────────────────────────────
# Without a key SMS codes cannot be sent; sign-up still works without a phone number.
# INFOBIP_API_KEY=
# INFOBIP_BASE_URL=https://api.infobip.com
# INFOBIP_SENDER_ID=Insurance

# ─── Firebase push notifications (optional) ──────────────────────────
# Either the path of the service-account JSON file, or its content in one variable.
# Never commit that file.
# FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT=

# ─── Google sign-in (optional) ───────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
# Client ids the mobile app's Google ID tokens are issued for
# GOOGLE_WEB_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# ─── Address checks and translation (optional) ───────────────────────
# Without a key, addresses are checked with OpenStreetMap only.
# GOOGLE_MAPS_API_KEY=
# TRANSLATION_API_URL=http://localhost:5000

# ─── AI assistant (optional) ──────────────────────────────────────────
# Any OpenAI-compatible provider. Without a key the app runs and the assistant
# answers with a "not configured" error.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=            # leave empty for api.openai.com
# OPENAI_MODEL=gpt-4o
# OPENAI_TIMEOUT_MS=30000
# OPENAI_JSON_MODE=true       # false for providers without response_format
# Daily message limits; a tenant can override them in config.ai
# AI_DAILY_MESSAGES_PER_USER=200
# AI_DAILY_MESSAGES_PER_TENANT=10000

# ─── Tenant DB Credential Encryption ─────────────────────────────────
# 32-byte hex key for AES-256 encryption of tenant database passwords
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TENANT_DB_ENCRYPTION_KEY=

# ─── Logging ──────────────────────────────────────────────────────────
DB_LOGGING=false
# error, warn, log, debug or verbose. Default: log in production, debug otherwise.
LOG_LEVEL=debug
