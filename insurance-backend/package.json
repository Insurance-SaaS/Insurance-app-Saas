{
    "name": "insurance-platform",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "lint:check": "eslint \"{src,test}/**/*.ts\" --quiet",
        "lint:sonar": "eslint --config eslint.sonar.config.mjs \"{src,test}/**/*.ts\"",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json",
        "test:cov:all": "jest --coverage --coverageReporters=lcov --coverageDirectory=../coverage/unit && jest --config ./test/jest-e2e.json --coverage --coverageReporters=lcov",
        "migrate": "ts-node -r tsconfig-paths/register src/cli/migrate.ts",
        "migrate:prod": "node dist/cli/migrate.js",
        "platform-admin": "ts-node -r tsconfig-paths/register src/cli/platform-admin.ts",
        "platform-admin:prod": "node dist/cli/platform-admin.js"
    },
    "dependencies": {
        "@fastify/helmet": "^13.1.1",
        "@fastify/multipart": "^9.2.1",
        "@fastify/swagger": "^9.5.1",
        "@fastify/swagger-ui": "^5.2.3",
        "@langchain/core": "^0.3.78",
        "@langchain/langgraph": "^0.4.9",
        "@langchain/langgraph-checkpoint": "^0.1.3",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.0.1",
        "@nestjs/event-emitter": "^3.0.1",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-fastify": "^11.1.6",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/throttler": "^6.5.0",
        "@nestjs/typeorm": "^11.0.0",
        "argon2": "^0.44.0",
        "axios": "^1.12.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^16.6.1",
        "firebase-admin": "^13.6.0",
        "google-auth-library": "^10.3.0",
        "ioredis": "^5.7.0",
        "minio": "^8.0.5",
        "mssql": "^11.0.2",
        "mysql2": "^3.24.5",
        "nodemailer": "^7.0.6",
        "openai": "^6.5.0",
        "oracledb": "^6.10.0",
        "passport": "^0.7.0",
        "passport-google-oauth20": "^2.0.0",
        "passport-jwt": "^4.0.1",
        "pg": "^8.16.3",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "^0.3.27"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@flydotio/dockerfile": "^0.7.10",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@swc/cli": "^0.6.0",
        "@swc/core": "^1.10.7",
        "@testcontainers/postgresql": "^12.2.0",
        "@types/busboy": "^1.5.4",
        "@types/jest": "^29.5.14",
        "@types/ms": "^2.1.0",
        "@types/node": "^22.10.7",
        "@types/nodemailer": "^7.0.1",
        "@types/passport-google-oauth20": "^2.0.16",
        "@types/passport-jwt": "^4.0.1",
        "@types/supertest": "^6.0.2",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-sonarjs": "^4.2.2",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "prettier": "^3.6.2",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "testcontainers": "^12.2.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/$1"
        },
        "transform": {
            "^.+\\.(t)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
